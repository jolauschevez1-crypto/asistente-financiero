# Instalación local: no necesita Neon ni cuentas de terceros.
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
DB_ENGINE=pglite
PGLITE_DATA_DIR=./data/local
JWT_SECRET=GENERAR_UN_SECRETO_ALEATORIO_LOCAL
REFRESH_JWT_SECRET=GENERAR_OTRO_SECRETO_ALEATORIO_LOCAL
CORS_ORIGIN=http://localhost:4201,http://127.0.0.1:4201,http://localhost:3001,http://127.0.0.1:3001

# Los servicios externos se activan únicamente cuando se configuren en el futuro.
AI_PROVIDER=disabled
AI_TIMEOUT_MS=30000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3
# Telegram queda para otra versión: el servidor ignora TELEGRAM_ENABLED.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcional para una migración futura, no se usa con DB_ENGINE=pglite.
DATABASE_URL=

# Tasas de referencia (BCE vía Frankfurter, sin clave). Se actualizan una vez al día, no en tiempo real.
# FX_PROVIDER=off desactiva la consulta; FX_PROVIDER_URL solo se cambia para pruebas locales.
FX_PROVIDER=
FX_PROVIDER_URL=
# En Vercel: secreto aleatorio de al menos 16 caracteres; el cron diario lo envía como Bearer.
CRON_SECRET=
